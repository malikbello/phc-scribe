#!/bin/sh
# Refuse commits not authored and committed by malikbello, or that carry
# co-author trailers or AI attribution (see docs/status.md, working agreement 1).
want="malikbello <139644523+malikbello@users.noreply.github.com>"
for kind in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${kind}_IDENT" | sed 's/ [0-9]* [-+][0-9]*$//')
  if [ "$ident" != "$want" ]; then
    echo "commit-msg: ${kind} is '$ident', expected '$want'" >&2
    exit 1
  fi
done
if grep -v '^#' "$1" | grep -qiE 'co-authored-by|generated (with|by)|claude|anthropic|claude\.ai/code|session_[0-9a-z]'; then
  echo "commit-msg: message contains a co-author trailer or AI attribution" >&2
  exit 1
fi
